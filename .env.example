# Server Configuration
PORT=3000
RAILS_MAX_THREADS=5

# Optional Overrides (both default to RAILS_MAX_THREADS if not set)
# DB_POOL=5
# SIDEKIQ_CONCURRENCY=5

# Docker Development Port Overrides (default to 5433 and 6380 to avoid conflicts with host services)
# DB_PORT=5433
# REDIS_PORT=6380

# Rails Master Key (Required in production if config/credentials/production.key is not placed on the server)
# RAILS_MASTER_KEY=

